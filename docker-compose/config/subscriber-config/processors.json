{
  "auditLogPersister": {
    "flushSize": 100,
    "flushInterval": 10,
    "flushTimeout": 10
  },
  "emailSender": {},
  "evaluationCountEventPersister": {
    "flushSize": 100,
    "flushInterval": 10,
    "writeCacheInterval": 1,
    "writeDAUInterval": 1,
    "userAttributeKeyTtl": 3600
  },
  "segmentUserPersister": {
    "domainEventProject": "bucketeer-dev",
    "domainEventTopic": "domain",
    "flushSize": 100,
    "flushInterval": 10,
    "pubSubType": "redis-stream",
    "redisServerName": "non-persistent-redis",
    "redisAddr": "redis:6379",
    "redisPoolSize": 25,
    "redisMinIdle": 25,
    "redisPartitionCount": 16,
    "redisMode": "auto",
    "project": "bucketeer-dev"
  },
  "postHogEvaluationExporter": {
    "enabled": false,
    "endpoint": "http://posthog-mock:8000",
    "projectApiKeyFile": "/etc/bucketeer/posthog/project-api-key",
    "allowInsecureEndpoint": true,
    "captureMode": "legacy",
    "exportEvaluations": true,
    "exportGoals": true,
    "batchSize": 100,
    "flushIntervalSeconds": 5,
    "deliveryTimeoutSeconds": 30,
    "maxQueueSize": 10000,
    "batchUploadTimeoutSeconds": 30,
    "shutdownTimeoutSeconds": 15,
    "privacy": {
      "userAttributeAllowlist": [],
      "metadataAllowlist": [],
      "groupMappings": [],
      "maxValueLength": 512,
      "maxAttributes": 20
    }
  },
  "postHogGoalExporter": {
    "enabled": false,
    "endpoint": "http://posthog-mock:8000",
    "projectApiKeyFile": "/etc/bucketeer/posthog/project-api-key",
    "allowInsecureEndpoint": true,
    "captureMode": "legacy",
    "exportEvaluations": true,
    "exportGoals": true,
    "batchSize": 100,
    "flushIntervalSeconds": 5,
    "deliveryTimeoutSeconds": 30,
    "maxQueueSize": 10000,
    "batchUploadTimeoutSeconds": 30,
    "shutdownTimeoutSeconds": 15,
    "privacy": {
      "userAttributeAllowlist": [],
      "metadataAllowlist": [],
      "groupMappings": [],
      "maxValueLength": 512,
      "maxAttributes": 20
    }
  }
}
